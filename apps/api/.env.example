# Copy to apps/api/.env for local dev. Values match infra/docker/docker-compose.yml.
# Every variable is validated at startup (src/config/env.ts).

NODE_ENV=development
# api = the HTTP API; worker = the scheduled jobs, no HTTP (`bun run dev` starts one of each)
APP_ROLE=api
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
DATABASE_URL=postgres://toasthub:toasthub@localhost:5432/toasthub

# Auth (Better Auth). Dev-only secret; generate a real one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Where clients reach /api/v1; magic links point here. The web origin: Vite proxies /api to the api, so
# the session cookie is first-party there.
BETTER_AUTH_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Mail (Mailpit in dev: UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Toasthub <no-reply@toasthub.local>

# Photo storage (MinIO in dev: console at http://localhost:9001; compose creates the bucket)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=toasthub-photos
S3_ACCESS_KEY_ID=toasthub
S3_SECRET_ACCESS_KEY=toasthub-secret
S3_FORCE_PATH_STYLE=true
