  "info": {
    "title": "Toasthub API",
    "description": "Errors use the `ErrorResponse` shape. See docs/SPEC.md §8. Sign-in endpoints under `/api/v1/auth/*` are served by Better Auth and not listed here.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "toasthub.session_token"
      },
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "MeResponseDto_Output": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "displayName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "avatarId": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6,
                "nullable": true
              },
              "locale": {
                "type": "string",
                "enum": [
                  "sk",
                  "en"
                ]
              },
              "profileVisibility": {
                "type": "string",
                "enum": [
                  "public",
                  "clan"
                ]
              },
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "admin"
                ]
              },
              "onboarded": {
                "type": "boolean"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "id",
              "email",
              "displayName",
              "avatarId",
              "locale",
              "profileVisibility",
              "role",
              "onboarded",
              "createdAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          },
          "avatarId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "nullable": true
          },
          "locale": {
            "type": "string",
            "enum": [
              "sk",
              "en"
            ]
          },
          "profileVisibility": {
            "type": "string",
            "enum": [
              "public",
              "clan"
            ]
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "PAYLOAD_TOO_LARGE",
                  "RATE_LIMITED",
                  "INTERNAL"
                ]
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
