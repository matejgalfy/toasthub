{
  "name": "@toasthub/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && bun run --parallel dev:compile dev:run",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:run": "node --watch --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/db/migrate.js",
    "auth:schema": "auth generate --config src/modules/auth/auth.cli.ts --output .generated/auth-schema.ts --yes",
    "openapi": "tsc -p tsconfig.build.json && node dist/openapi.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@toasthub/shared": "workspace:*",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "fastify": "5.11.3",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "auth": "1.7.14",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "testcontainers": "12.2.1",
    "vitest": "5.0.5"
  }
}
